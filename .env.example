# Copy to .env.local (never commit .env.local). All values below are placeholders.

# --- Supabase (required) -------------------------------------------------------
# Project Settings -> API. Use the project URL and the *publishable* key (sb_publishable_...) —
# or the legacy "anon" key. Both are safe to expose to browsers; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Maps (optional; the app degrades gracefully without it) ------------------------
# https://account.mapbox.com/ -> create a PUBLIC token (pk.…) and restrict it to your site URLs.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# --- Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secret: ONLY for `npm run seed:demo` / `unseed:demo` -------------------
# The running app NEVER needs this. Do not set it in your hosting provider. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
